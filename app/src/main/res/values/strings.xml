    <!--
      Both halves are already-formatted phrases: %1$s is a book count such as "5 books" and %2$s is a
      finished count such as "2 finished". Joined here rather than built as one format string, so each
      count can carry its own plural form in a language that inflects them differently.
    -->
    <string name="series_summary_progress">%1$s · %2$s</string>
    <!-- %1$s is a book count such as "5 books". -->
    <string name="series_summary_finished">%1$s · finished</string>
