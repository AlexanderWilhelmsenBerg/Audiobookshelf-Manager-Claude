    <!--
      PRODUCT_SPEC 3.1 — counts are plurals, not formatted strings.

      English needs two forms, but the languages this will be translated into do not all agree on
      which counts share a form. A `<plurals>` lets each locale supply the set it needs; `%1$d books`
      forces every translator into English's two-way split.
    -->
    <plurals name="home_library_books">
        <item quantity="one">%1$d book</item>
        <item quantity="other">%1$d books</item>
    </plurals>

    <!-- PRODUCT_SPEC LIB-003 — how many books are in one series. -->
    <plurals name="series_book_count">
        <item quantity="one">%1$d book</item>
        <item quantity="other">%1$d books</item>
    </plurals>

    <!--
      How many of a series' books are finished. English inflects nothing here, but the two forms are
      declared anyway: a locale that does inflect cannot add one to a `<string>`.
    -->
    <plurals name="series_finished_count">
        <item quantity="one">%1$d finished</item>
        <item quantity="other">%1$d finished</item>
    </plurals>

    <!-- PRODUCT_SPEC LIB-001 — a sync that could not reach every item says so instead of claiming a clean run. -->
    <plurals name="home_sync_partial">
        <item quantity="one">%1$d book. The last refresh could not reach all of them.</item>
        <item quantity="other">%1$d books. The last refresh could not reach all of them.</item>
    </plurals>

    <plurals name="book_tracks">
        <item quantity="one">%1$d audio file</item>
        <item quantity="other">%1$d audio files</item>
    </plurals>
</resources>
