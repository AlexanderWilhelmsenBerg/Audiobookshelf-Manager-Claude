<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      PRODUCT_SPEC 15 — the network permission is the only one Phase 0 needs. Foreground-service,
      notification, Bluetooth and wake-lock permissions arrive with the playback service (Phase 2)
      and the download coordinator (Phase 3), so that an install today cannot request more than the
      app can actually use.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      PRODUCT_SPEC 11.1 — two Android Auto lint checks are suppressed here, and both are false positives
      this module can prove.

      `MissingMediaBrowserServiceIntentFilter` and `MissingIntentFilterForMediaSearch` look for those two
      actions on a service declared in *this* module's manifest. The service is `PlaybackService` in
      `:playback`, which is where PLAY-001 requires it to live — the module boundary is what keeps "one
      media session" structural — so the checks cannot see it.

      Both actions are present in the merged manifest that ships. To confirm rather than trust:

          grep -n "MediaBrowserService\|MEDIA_PLAY_FROM_SEARCH" \
            app/build/intermediates/merged_manifest/debug/processDebugMainManifest/AndroidManifest.xml

      They are declared in `playback/src/main/AndroidManifest.xml`, and both are implemented —
      `onGetLibraryRoot`/`onGetChildren` for browsing and `onSearch`/`onGetSearchResult` for the spoken
      query. A suppression for something unimplemented would be the wrong call; this one is for a check
      that is looking in the wrong module.
    -->
    <application
        android:name=".ShelfPlayerApplication"
        tools:ignore="MissingMediaBrowserServiceIntentFilter,MissingIntentFilterForMediaSearch"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShelfPlayer"
        tools:targetApi="31">

        <!-- No android:label: the activity inherits the application's, and repeating it is the
             RedundantLabel lint error. -->
        <!--
          PRODUCT_SPEC PLAY-001 / 11.1 — declares this app to Android Auto.

          A device run found the app missing from the car's dashboard entirely, and this is why: Auto
          enumerates apps by this metadata, not by the media-browser intent filter the service already
          declares. Without it a perfect browse tree is a tree nobody can reach.

          In `:app` rather than beside the service in `:playback`, because Auto reads it from the installed
          application, and keeping it here puts the declaration with the thing that is actually installed.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:resizeableActivity="true"
            android:theme="@style/Theme.ShelfPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          PRODUCT_SPEC SYNC-003 — the app provides WorkManager's configuration itself, so that workers
          can be constructed with injected dependencies. Leaving the default initializer in place would
          initialise WorkManager before Hilt's factory exists, and the first worker would fail to build.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
