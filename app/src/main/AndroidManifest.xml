<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      PRODUCT_SPEC 15 — the network permission is the only one Phase 0 needs. Foreground-service,
      notification, Bluetooth and wake-lock permissions arrive with the playback service (Phase 2)
      and the download coordinator (Phase 3), so that an install today cannot request more than the
      app can actually use.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      PRODUCT_SPEC DL-001 — "download continues in background with a progress notification".

      A transfer that stopped when the user left the app would make the feature useless: a book is
      downloaded precisely so somebody can put the phone in a pocket and walk away. `dataSync` is the type
      Android requires a network transfer to declare from API 34, and `POST_NOTIFICATIONS` is what the
      progress notification needs from API 33 — without it the download still runs and is simply invisible,
      which is why the app does not treat a refusal as an error.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      PRODUCT_SPEC 11.1 — two Android Auto lint checks are suppressed here, and both are false positives
      this module can prove.

      `MissingMediaBrowserServiceIntentFilter` and `MissingIntentFilterForMediaSearch` look for those two
      actions on a service declared in *this* module's manifest. The service is `PlaybackService` in
      `:playback`, which is where PLAY-001 requires it to live — the module boundary is what keeps "one
      media session" structural — so the checks cannot see it.

      Both actions are present in the merged manifest that ships. To confirm rather than trust:

          grep -n "MediaBrowserService\|MEDIA_PLAY_FROM_SEARCH" \
            app/build/intermediates/merged_manifest/debug/processDebugMainManifest/AndroidManifest.xml

      They are declared in `playback/src/main/AndroidManifest.xml`, and both are implemented —
      `onGetLibraryRoot`/`onGetChildren` for browsing and `onSearch`/`onGetSearchResult` for the spoken
      query. A suppression for something unimplemented would be the wrong call; this one is for a check
      that is looking in the wrong module.
    -->
    <application
        android:name=".ShelfPlayerApplication"
        tools:ignore="MissingMediaBrowserServiceIntentFilter,MissingIntentFilterForMediaSearch"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShelfPlayer"
        tools:targetApi="33">

        <!-- No android:label: the activity inherits the application's, and repeating it is the
             RedundantLabel lint error. -->
        <!--
          PRODUCT_SPEC PLAY-001 / 11.1 — declares this app to Android Auto.

          A device run found the app missing from the car's dashboard entirely, and this is why: Auto
          enumerates apps by this metadata, not by the media-browser intent filter the service already
          declares. Without it a perfect browse tree is a tree nobody can reach.

          In `:app` rather than beside the service in `:playback`, because Auto reads it from the installed
          application, and keeping it here puts the declaration with the thing that is actually installed.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
          PRODUCT_SPEC SET-003 — the activity has no launcher filter of its own, because the launcher
          entry has to be switchable and an activity's own icon is not.

          Android offers exactly one mechanism for a user-chosen app icon: several `activity-alias`
          entries pointing at one activity, of which exactly one is enabled. The icon a launcher draws is
          the *enabled alias's*, so choosing an icon means enabling one alias and disabling the other
          five (`LauncherIcons`). `exported="false"` is correct here — every entry point is an alias, and
          nothing outside the app starts this activity directly.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:resizeableActivity="true"
            android:theme="@style/Theme.ShelfPlayer" />

        <!--
          The six icons, in the order the picker shows them. Indigo is the one enabled out of the box; the
          rest are disabled until somebody chooses them, and `LauncherIcons` keeps exactly one enabled.

          No `android:label` on any of them: the alias inherits the application's, and repeating it is
          lint's `RedundantLabel`. All six are the same app under the same name — only the picture differs.
        -->
        <activity-alias
            android:name=".launcher.IndigoAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_indigo"
            android:roundIcon="@mipmap/ic_launcher_indigo_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.SpectrumAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_spectrum"
            android:roundIcon="@mipmap/ic_launcher_spectrum_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.CrimsonAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_crimson"
            android:roundIcon="@mipmap/ic_launcher_crimson_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.IlluminatedAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_illuminated"
            android:roundIcon="@mipmap/ic_launcher_illuminated_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.VintageAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_vintage"
            android:roundIcon="@mipmap/ic_launcher_vintage_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.MonochromeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_monochrome"
            android:roundIcon="@mipmap/ic_launcher_monochrome_round">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!--
          PRODUCT_SPEC DL-001 — WorkManager's own foreground service, told what kind of work it hosts.

          `tools:node="merge"` rather than a fresh declaration: the service belongs to `androidx.work`,
          which already declares it. From API 34 a foreground service must state its type or `setForeground`
          throws — on the newest devices only, which is exactly the failure that reaches a user before it
          reaches a test.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        <!--
          PRODUCT_SPEC SYNC-003 — the app provides WorkManager's configuration itself, so that workers
          can be constructed with injected dependencies. Leaving the default initializer in place would
          initialise WorkManager before Hilt's factory exists, and the first worker would fail to build.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
