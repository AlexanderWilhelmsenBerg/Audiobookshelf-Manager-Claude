<?xml version="1.0" encoding="UTF-8"?>
<!--
  PRODUCT_SPEC 16.1 / 15 — dependency verification.

  This file is the verification *policy*. The per-artifact checksums are generated by
  scripts/bootstrap-dependency-verification.sh, which must run in an environment that can reach every
  configured repository.

  Until that bootstrap has run, gradle.properties sets `org.gradle.dependency.verification=off`:
  with no checksums there is nothing to check against, and `lenient` would only print every resolved
  artifact as an unverified-artifact report on every build. Flip it to `strict` in the same commit
  that adds the generated `<components>` block. See docs/adr/0006.

  `verify-signatures` stays false: several AndroidX and Google artifacts are unsigned, so enabling it
  today would produce a wall of failures that says nothing about supply-chain risk. SHA-256 checksums
  pinned against the resolved version set are the guarantee that actually holds here.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
   </configuration>
   <components/>
</verification-metadata>
